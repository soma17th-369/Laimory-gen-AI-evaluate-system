# LangFuse 접근 정보. 이 파일은 키 "이름"만 담는 예시다.
# 실제 값은 로컬 `.env` 에만 두고 저장소에 커밋하지 않는다(.env 는 .gitignore 대상).
#
# LangFuse 프로젝트(환경)마다 키가 따로다. 키가 설정된 프로젝트를 모두 수집해 한 목록에
# 합치고, 어느 프로젝트에서 온 로그인지는 행의 `env` 값으로 구분한다.

# 개발(dev) 프로젝트
LANGFUSE_DEV_PUBLIC_KEY=
LANGFUSE_DEV_SECRET_KEY=

# 운영(prod) 프로젝트
LANGFUSE_PROD_PUBLIC_KEY=
LANGFUSE_PROD_SECRET_KEY=

# LangFuse Cloud 리전: https://cloud.langfuse.com (EU) / https://us.cloud.langfuse.com (US)
#   / https://jp.cloud.langfuse.com (JP) / 셀프호스트면 그 인스턴스 URL
# 두 프로젝트가 같은 인스턴스에 있으면 이 한 줄이면 된다.
LANGFUSE_HOST=https://cloud.langfuse.com
# 인스턴스가 서로 다를 때만 환경별로 덮어쓴다(비우면 위 LANGFUSE_HOST 를 쓴다).
# LANGFUSE_DEV_HOST=
# LANGFUSE_PROD_HOST=

# 접두사 없는 아래 이름은 환경 구분이 없던 시절의 것이라 dev 기본값으로만 읽는다.
# 새로 설정한다면 LANGFUSE_DEV_* 를 쓴다.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# OpenAI (M2 채점/분석용). 키는 로컬 .env 에만.
OPENAI_API_KEY=
# judge 모델. 더 정확한(비싼) 모델을 쓰려면 여기서 바꾼다(접근 가능한 OpenAI 모델명).
OPENAI_JUDGE_MODEL=gpt-4o
