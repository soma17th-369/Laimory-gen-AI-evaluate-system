# LangFuse 접근 정보. 이 파일은 키 "이름"만 담는 예시다.
# 실제 값은 로컬 `.env` 에만 두고 저장소에 커밋하지 않는다(.env 는 .gitignore 대상).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LangFuse Cloud 리전: https://cloud.langfuse.com (EU) / https://us.cloud.langfuse.com (US)
#   / https://jp.cloud.langfuse.com (JP) / 셀프호스트면 그 인스턴스 URL
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenAI (M2 채점/분석용). 키는 로컬 .env 에만.
OPENAI_API_KEY=
# judge 모델. 더 정확한(비싼) 모델을 쓰려면 여기서 바꾼다(접근 가능한 OpenAI 모델명).
OPENAI_JUDGE_MODEL=gpt-4o
